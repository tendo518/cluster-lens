{
  "$defs": {
    "ConfigHost": {
      "properties": {
        "address": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Address",
          "type": "string",
          "x-error": "节点地址无效"
        },
        "agent_token": {
          "maxLength": 256,
          "minLength": 16,
          "pattern": "^[!-~]+$",
          "title": "Agent Token",
          "type": "string",
          "x-error": "每个节点必须使用独立于其他节点及 viewer_token 的有效令牌"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "title": "Groups",
          "type": "array",
          "x-error": "节点 groups 应为字符串列表"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string",
          "x-error": "节点名称无效或重复"
        }
      },
      "required": [
        "name",
        "address",
        "agent_token"
      ],
      "title": "ConfigHost",
      "type": "object"
    },
    "UIConfig": {
      "additionalProperties": false,
      "properties": {
        "avatar": {
          "default": "CL",
          "maxLength": 3,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Avatar",
          "type": "string",
          "x-error": "ui.avatar 应为不含控制字符且长度不超过 3 的文本"
        },
        "footer": {
          "default": "ClusterLens",
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Footer",
          "type": "string",
          "x-error": "ui.footer 应为不含控制字符且长度不超过 120 的文本"
        },
        "heading": {
          "default": "集群运行监控",
          "maxLength": 80,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Heading",
          "type": "string",
          "x-error": "ui.heading 应为不含控制字符且长度不超过 80 的文本"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "mark": {
          "default": "C",
          "maxLength": 2,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Mark",
          "type": "string",
          "x-error": "ui.mark 应为不含控制字符且长度不超过 2 的文本"
        },
        "name": {
          "default": "ClusterLens",
          "maxLength": 40,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Name",
          "type": "string",
          "x-error": "ui.name 应为不含控制字符且长度不超过 40 的文本"
        },
        "palette": {
          "default": "green",
          "enum": [
            "green",
            "blue",
            "purple",
            "amber",
            "teal",
            "rose"
          ],
          "title": "Palette",
          "type": "string",
          "x-error": "ui.theme 或 ui.palette 无效"
        },
        "subtitle": {
          "default": "SERVER MONITORING",
          "maxLength": 60,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Subtitle",
          "type": "string",
          "x-error": "ui.subtitle 应为不含控制字符且长度不超过 60 的文本"
        },
        "theme": {
          "default": "system",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "title": "Theme",
          "type": "string",
          "x-error": "ui.theme 或 ui.palette 无效"
        },
        "title": {
          "default": "ClusterLens · 服务器监控",
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Title",
          "type": "string",
          "x-error": "ui.title 应为不含控制字符且长度不超过 120 的文本"
        },
        "workspace": {
          "default": "服务器集群",
          "maxLength": 60,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Workspace",
          "type": "string",
          "x-error": "ui.workspace 应为不含控制字符且长度不超过 60 的文本"
        },
        "workspace_subtitle": {
          "default": "Monitoring workspace",
          "maxLength": 80,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Workspace Subtitle",
          "type": "string",
          "x-error": "ui.workspace_subtitle 应为不含控制字符且长度不超过 80 的文本"
        }
      },
      "title": "UIConfig",
      "type": "object"
    }
  },
  "properties": {
    "hosts": {
      "items": {
        "$ref": "#/$defs/ConfigHost"
      },
      "minItems": 1,
      "title": "Hosts",
      "type": "array",
      "x-error": "配置 hosts 必须是非空列表"
    },
    "interval": {
      "default": 30,
      "maximum": 3600,
      "minimum": 5,
      "title": "Interval",
      "type": "integer",
      "x-error": "配置 interval 应为 5—3600 秒"
    },
    "retention_days": {
      "default": 30,
      "maximum": 365,
      "minimum": 1,
      "title": "Retention Days",
      "type": "integer",
      "x-error": "retention_days 应为 1—365"
    },
    "stale_after": {
      "default": 100,
      "maximum": 86400,
      "minimum": 30,
      "title": "Stale After",
      "type": "integer",
      "x-error": "stale_after 应不少于 30 秒且不少于两倍采样间隔"
    },
    "ui": {
      "$ref": "#/$defs/UIConfig"
    },
    "version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer",
      "x-error": "监控配置必须是 version=1 的 JSON 对象"
    },
    "viewer_token": {
      "maxLength": 256,
      "minLength": 16,
      "pattern": "^[!-~]+$",
      "title": "Viewer Token",
      "type": "string",
      "x-error": "viewer_token 必须为至少 16 位无空白的可打印 ASCII 字符"
    }
  },
  "required": [
    "version",
    "viewer_token",
    "hosts"
  ],
  "title": "ServerConfig",
  "type": "object"
}
